# ============================================================================
# Invora — environment template.  Copy to .env.local and fill in.
# .env.local is git-ignored.  See docs/ENV.md for where each value comes from.
# ============================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Invora
NODE_ENV=development

# ---- Supabase ----  https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # browser-safe, RLS-protected
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_DB_URL=postgresql://...              # migrations only (Supabase CLI)

# ---- Anthropic ----  https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...            # SERVER ONLY

# ---- Razorpay ----  https://dashboard.razorpay.com -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...      # public, used by checkout.js
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...                       # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=...                   # SERVER ONLY, set when creating the webhook
RAZORPAY_PLAN_ID_PREMIUM_MONTHLY=plan_...
RAZORPAY_PLAN_ID_PREMIUM_YEARLY=plan_...

# ---- Email ----  https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM="Invora <invoices@yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com
CONTACT_EMAIL=support@yourdomain.com          # where /contact form submissions are sent

# ---- Rate limiting ----  https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ---- Monitoring ----  https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=                            # build-time source maps (optional)

# ---- Secrets you generate yourself: openssl rand -hex 32 ----
SHARE_LINK_SECRET=                            # HMAC signing for public doc links
CRON_SECRET=                                  # guards /api/cron/* against public calls

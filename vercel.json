{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/overdue",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/expire-quotes",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/usage-reset",
      "schedule": "10 2 * * *"
    }
  ],
  "functions": {
    "app/api/ai/**/route.ts": {
      "maxDuration": 300
    },
    "app/api/pdf/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/documents/send/route.ts": {
      "maxDuration": 60
    }
  }
}
